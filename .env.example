# Supermarket Checkout Simulation - environment configuration
# Copy this file to ".env" and adjust values. Never commit real secrets.

# SQL Server connection
DB_SERVER=localhost
DB_DATABASE=QUENTRA_RETAIL
DB_USER=sa
DB_PASSWORD=Password1
# Optional: instance/port. Leave DB_PORT empty to use default 1433.
DB_PORT=
# Set DB_ENCRYPT to disable/false for local dev without TLS certs.
DB_ENCRYPT=disable
# Set DB_TRUST_SERVER_CERT to true to accept self-signed certs.
DB_TRUST_SERVER_CERT=true

# Quentra gateway (TDS proxy in front of SQL Server). Live mode of the
# report-cache simulation connects here so Quentra can serve cached results.
# Defaults to DB_SERVER on port 14330.
QUENTRA_SERVER=localhost
QUENTRA_PORT=14330

# OpenAI — powers the corporate assistant in the AI Guard simulation.
# Leave OPENAI_API_KEY empty to run the simulation offline: the assistant then
# falls back to a deterministic engine and the UI labels its answers
# "MODELLENDİ" instead of claiming a real model call.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Point at an Azure OpenAI or compatible self-hosted endpoint if needed.
OPENAI_BASE_URL=https://api.openai.com/v1

# ElevenLabs — voices the story-mode narration (hospital masking sim).
# Leave ELEVENLABS_API_KEY empty to run silent: /api/tts answers 503 and the
# story simply plays without audio. Generated clips are cached in tts_cache/,
# so each narration line is billed once, ever.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=zDBYcuJrpuZ6YQ7AgRUw
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# HTTP server
HTTP_ADDR=:8099
